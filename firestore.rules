rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isChatMember(chatData) {
      return isAuthenticated() && (
        chatData.type == 'channel' ||
        (chatData.memberIds is list && chatData.memberIds.hasAny([request.auth.uid]))
      );
    }

    function isChatAdmin(chatData) {
      return isAuthenticated() && (
        chatData.ownerId == request.auth.uid ||
        chatData.createdBy == request.auth.uid ||
        (chatData.adminIds is list && chatData.adminIds.hasAny([request.auth.uid]))
      );
    }

    function isChatOwner(chatData) {
      return isAuthenticated() && (
        chatData.ownerId == request.auth.uid ||
        chatData.createdBy == request.auth.uid
      );
    }

    function isUserMutedOrBanned(chatData) {
      return (chatData.mutedUserIds is list && chatData.mutedUserIds.hasAny([request.auth.uid])) ||
             (chatData.bannedUserIds is list && chatData.bannedUserIds.hasAny([request.auth.uid]));
    }

    // Helper for story access
    function canReadStory(storyData) {
      return isAuthenticated() && (
        storyData.userId == request.auth.uid ||
        (
          // Check expiration
          storyData.expiresAt > request.time.toMillis() &&
          // Check privacy rules
          (
            (storyData.privacy == 'everyone' && (!(storyData.excludedUserIds is list) || !storyData.excludedUserIds.hasAny([request.auth.uid]))) ||
            (storyData.privacy == 'contacts' && (!(storyData.excludedUserIds is list) || !storyData.excludedUserIds.hasAny([request.auth.uid]))) ||
            (storyData.privacy == 'close_friends' && (storyData.allowedUserIds is list && storyData.allowedUserIds.hasAny([request.auth.uid]))) ||
            (storyData.privacy == 'selected' && (storyData.allowedUserIds is list && storyData.allowedUserIds.hasAny([request.auth.uid]))) ||
            (storyData.privacy == 'exclude' && (!(storyData.excludedUserIds is list) || !storyData.excludedUserIds.hasAny([request.auth.uid])))
          )
        )
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Usernames collection for unique handle reservation
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Chats Collection (Private Chats, Groups, Channels)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource.data.type == 'channel' ||
        (resource.data.memberIds is list && resource.data.memberIds.hasAny([request.auth.uid])) ||
        (resource.data.inviteCode is string && resource.data.isInviteLinkRevoked != true)
      );

      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        (request.resource.data.memberIds is list && request.resource.data.memberIds.hasAny([request.auth.uid]))
      );

      allow update: if isAuthenticated() && (
        isChatAdmin(resource.data) ||
        (
          isChatMember(resource.data) &&
          !isUserMutedOrBanned(resource.data)
        ) ||
        (
          resource.data.inviteCode is string &&
          resource.data.isInviteLinkRevoked != true &&
          (!resource.data.bannedUserIds.hasAny([request.auth.uid])) &&
          request.resource.data.memberIds.hasAny([request.auth.uid])
        )
      );

      allow delete: if isAuthenticated() && isChatOwner(resource.data);

      function getChatData(cId) {
        return get(/databases/$(database)/documents/chats/$(cId)).data;
      }

      function canSendMessageInChat(cId) {
        return (
          getChatData(cId).type == 'channel'
            ? (getChatData(cId).adminIds.hasAny([request.auth.uid]))
            : (
                getChatData(cId).memberIds.hasAny([request.auth.uid]) &&
                (!getChatData(cId).mutedUserIds.hasAny([request.auth.uid])) &&
                (!getChatData(cId).bannedUserIds.hasAny([request.auth.uid])) &&
                (
                  getChatData(cId).permissions.sendMessages != 'admins_only' ||
                  getChatData(cId).adminIds.hasAny([request.auth.uid]) ||
                  getChatData(cId).ownerId == request.auth.uid
                )
              )
        );
      }

      // Subcollection: Members
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          getChatData(chatId).type == 'channel' ||
          getChatData(chatId).memberIds.hasAny([request.auth.uid])
        );
        allow create, update: if isAuthenticated() && (
          isChatAdmin(getChatData(chatId)) ||
          (request.auth.uid == memberId && getChatData(chatId).inviteCode is string && getChatData(chatId).isInviteLinkRevoked != true)
        );
        allow delete: if isAuthenticated() && (
          isChatAdmin(getChatData(chatId)) ||
          request.auth.uid == memberId
        );
      }

      // Subcollection: Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          getChatData(chatId).type == 'channel' ||
          getChatData(chatId).memberIds.hasAny([request.auth.uid])
        );

        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          canSendMessageInChat(chatId);

        allow update: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          getChatData(chatId).memberIds.hasAny([request.auth.uid]) ||
          getChatData(chatId).adminIds.hasAny([request.auth.uid])
        );

        allow delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          getChatData(chatId).adminIds.hasAny([request.auth.uid]) ||
          getChatData(chatId).ownerId == request.auth.uid
        );
      }

      // Subcollection: Channel Posts
      match /posts/{postId} {
        allow read: if isAuthenticated() && (
          getChatData(chatId).type == 'channel' ||
          getChatData(chatId).memberIds.hasAny([request.auth.uid])
        );
        
        allow create: if isAuthenticated() && isChatAdmin(getChatData(chatId));

        allow update: if isAuthenticated() && (
          isChatAdmin(getChatData(chatId)) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'reactions', 'userReactions', 'forwardsCount', 'commentsCount'])
        );

        allow delete: if isAuthenticated() && isChatAdmin(getChatData(chatId));

        // Nested subcollection: Post Comments & Discussion
        match /comments/{commentId} {
          allow read: if isAuthenticated() && (
            getChatData(chatId).type == 'channel' ||
            getChatData(chatId).memberIds.hasAny([request.auth.uid])
          );

          allow create: if isAuthenticated() &&
            request.resource.data.userId == request.auth.uid &&
            (getChatData(chatId).isCommentsEnabled != false);

          allow update: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            isChatAdmin(getChatData(chatId))
          );

          allow delete: if isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            isChatAdmin(getChatData(chatId))
          );
        }
      }
    }

    // Phase 5: Production-Ready Real-time Ephemeral Stories
    match /stories/{storyId} {
      // Server-side privacy and 24-hour expiration enforcement
      allow read: if canReadStory(resource.data);

      // Create story: authenticated user matching owner, must provide expiration timestamp
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.expiresAt is number;

      // Update story: owner can edit or viewers can increment counters
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'reactionsCount'])
      );

      // Delete story: only story creator/owner
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Story Views Subcollection: Track who viewed
      match /views/{viewerId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid ||
          request.auth.uid == viewerId
        );
        allow create, update: if isAuthenticated() && request.auth.uid == viewerId;
        allow delete: if false;
      }

      // Story Reactions Subcollection: Real-time reactions
      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // Story Replies Subcollection: Real-time replies
      match /replies/{replyId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid ||
          resource.data.senderId == request.auth.uid
        );
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Story Moderation & Reports
    match /storyReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; // Admin backend only
    }

    // Fintech Transactions & Passbook
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow update: if false; // Immutable ledger
      allow delete: if false;
    }

    // User Notifications
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isOwner(userId);
    }

    // Phase 6: WebRTC Real-Time 1-to-1 Voice and Video Call Signaling
    match /calls/{callId} {
      // Read call session if caller or receiver
      allow read: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      // Initiate call: authenticated caller
      allow create: if isAuthenticated() &&
        request.resource.data.callerId == request.auth.uid;

      // Update call (accept, decline, end, sdp answer, status change)
      allow update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      // Delete call: caller can clean up
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      // Subcollection: Caller ICE Candidates
      match /callerCandidates/{candidateId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Subcollection: Callee ICE Candidates
      match /calleeCandidates/{candidateId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }
  }
}
